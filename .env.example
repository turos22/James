# Credenciais do James. Copie para .env e preencha.
# O .env NUNCA é versionado.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# Tavily — https://app.tavily.com
TAVILY_API_KEY=

# Postgres local (docker-compose.yml lê estas duas)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://james:SENHA@localhost:5434/james?sslmode=disable

# Opcional. Sobrescreve [ferramentas.claude_code].diretorio do config.toml
# nesta máquina (o toml é versionado e tem o caminho do Windows).
# JAMES_CLAUDE_CODE_DIRETORIO=/home/<usuario>/SI/Projetos/james-workspace

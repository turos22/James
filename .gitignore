# Segredos
.env

# Binários e artefatos de build
*.exe
build/bin/
shell/build/
shell/frontend/wailsjs/
frontend/dist/
frontend/package.json.md5
web/dist/

# Certificado TLS da VPN Tailscale — gerado localmente por máquina
# (tailscale cert), nunca é o mesmo em duas máquinas, não é segredo
# "roubável" fora da rede, mas não faz sentido versionar.
certs/

# Dependências
node_modules/
__pycache__/
.venv/
*.egg-info/
.pytest_cache/

# Bibliotecas nativas pesadas — baixadas à parte, não versionadas
*.dll
*.lib
vosk/
TTs/

# Banco legado (migrado para Postgres na Fase 1)
Athena.db
Athena.db-shm
Athena.db-wal

# Histórico diário de conversa (mesma razão do Athena.db acima:
# dado pessoal, não pertence ao repositório)
Vault/Logs_Diarios/
Vault/Memoria/

# Áudio gerado pelo TTS: um arquivo por resposta falada, nome UUID. O front
# apaga via DELETE /api/audio/{id} depois de tocar, mas quando o autoplay é
# bloqueado ou a aba fecha antes, o arquivo fica — e são gravações das
# conversas do Arthur. Ignorar o diretório inteiro em vez de nome a nome:
# antes só `audios/audio_jarvis.mp3` estava listado, e qualquer resposta
# gerada podia ser commitada por acidente.
#
# Regra do .gitignore que torna isto seguro: arquivo JÁ rastreado continua
# rastreado, então os assets versionados (entrada.mp3, faaah.wav,
# um_minuto.mp3 e os .wav de bordão) não saem do repositório.
audios/*

# Material de referência de terceiros (obsidian.py é insumo da Fase 4)
arquivos do Gui/

# Mockups do companion visual de brainstorm — material de sessão,
# regenerável, não é entregável.
.superpowers/

# Log de calibração de quase-acertos da wake word (Fase 5, D10) —
# transcrição do que o Arthur falou, dado pessoal, não pertence ao repo.
dispositivo/wake_candidatos.log
